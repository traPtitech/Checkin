{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // ツールが生成するドットフォルダを除外する。対象がどれで、クラス全体を除外する
  // 形にしている理由は eslint.config.mjs の ignores のコメントにある。
  //
  // これらのフォルダは入れ子の .gitignore(例: .remember/.gitignore の `*`)で git
  // からは除外されているが、knip はそれを見ずに中のファイルを挙げる。リポジトリ
  // 直下の .gitignore に1つずつ足せば knip も挙げなくなるが、それではツールが
  // 増えるたびに触ることになる。
  //
  // フォルダは追跡しておらず、作業する人の環境によって在ったり無かったりする。
  // 無い環境で knip を実行すると、この指定に一致するファイルが1つも無いため
  // Configuration hint(`**/.*/**  knip.jsonc  Remove from ignore`)が出る。
  // このヒントが示すのは、判定した環境にそうしたフォルダが無かったことだけである。
  // ヒントに従ってこの指定を外すと、フォルダが在る環境では中の .ts / .cjs が未使用
  // ファイルとして挙がり、`pnpm knip` が exit 1 で落ちる。現に一度外したことで
  // main が落ちた。外してよいかを判定するには、そうしたフォルダが在る作業ツリーで
  // 確かめる必要がある。
  //
  // 以上はいずれも knip 6.31.0 で実測。
  "ignore": ["**/.*/**"],
  "workspaces": {
    ".": {
      // scripts/e2e/ は実データ(実 Stripe / 実 Jomon)に対する E2E 検証を手で
      // 実行するためのスクリプトで、アプリのコードからは import されない。
      // 各 run_*.mjs を直接 node で起動し、共有処理を harness.mjs が持つ。
      // entry として宣言しないと knip が未使用ファイルとして挙げる。残す理由は、
      // 各 change の tasks.md に BLOCKED で残る E2E を後から実施するのに、
      // この検証手段が要るためである。
      "entry": ["scripts/e2e/*.mjs"],
      "ignoreBinaries": [
        // run_payout.mjs と run_special.mjs が execFileSync で呼ぶ MariaDB の
        // クライアントで、npm のパッケージではなく検証を行うマシンに入って
        // いるものを使う。npm の依存として宣言できないため knip に伝える。
        "mysql"
      ],
      "ignoreDependencies": [
        // `openspec` コマンドとしてのみ使う CLI で、ソースからは import しない。
        // Knip は import 文から依存を辿るため、これを検出できない
        // — https://knip.dev/reference/faq 参照
        "@fission-ai/openspec"
      ]
    },
    "apps/web": {
      "ignoreDependencies": [
        // Vue SFC のコンパイル(ランタイムヘルパー、コンパイラマクロ)や
        // `nuxt typecheck` が内部で呼び出す vue-tsc から暗黙的に使われる。
        // Knip 組み込みの Vue コンパイラは import 文しか抽出しないため、
        // これらを検出できない — https://knip.dev/reference/faq 参照
        "vue",
        "vue-tsc"
      ]
    },
    "packages/api": {},
    "packages/api-contract": {},
    "packages/db": {}
  }
}
