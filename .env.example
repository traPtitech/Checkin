# MariaDB connection string used by Drizzle (drizzle-orm/mysql2) and the Nitro server.
DATABASE_URL="mysql://checkin:password@localhost:3306/checkin"

# --- Auth foundation (OpenSpec: add-auth-foundation) ---

# HMAC secret for mail_hash. REQUIRED. Keep stable — changing it breaks the
# person <-> Stripe correspondence table. Generate e.g. `openssl rand -hex 32`.
MAIL_HASH_SECRET=""

# Comma-separated isct email domains allowed to verify (mail_hash key source).
ISCT_ALLOWED_EMAIL_DOMAINS="m.isct.ac.jp"

# Absolute origin of this app; used to build magic-link / OAuth redirect URLs
# and to validate same-site redirects. e.g. https://checkin.trap.jp
APP_ORIGIN="http://localhost:3000"

# Token / session lifetimes (seconds).
EMAIL_VERIFICATION_TTL="1800"
SESSION_TTL="2592000"

# Comma-separated traQ IDs (usernames) granted accountant (admin) access.
CHECKIN_ACCOUNTANT_TRAQ_IDS=""

# traQ OAuth (client registered out-of-band; fill in from the registration).
TRAQ_OAUTH_CLIENT_ID=""
TRAQ_OAUTH_CLIENT_SECRET=""
TRAQ_OAUTH_AUTHORIZE_URL=""
TRAQ_OAUTH_TOKEN_URL=""
TRAQ_OAUTH_USERINFO_URL=""
TRAQ_OAUTH_SCOPE=""
# Field in the userinfo response that holds the traQ ID (username).
TRAQ_OAUTH_USER_ID_FIELD="name"

# Mailer: "log" (dev, prints to console) or "sendgrid" (production).
MAILER_DRIVER="log"
MAIL_FROM="noreply@localhost"
SENDGRID_API_KEY=""

# --- Membership collection / Stripe (OpenSpec: add-membership-collection) ---

# Stripe secret key (test mode to start, sk_test_...). Leave empty for auth-only
# dev — the Stripe adapter is lazy, so non-billing requests work without it.
STRIPE_SECRET_KEY=""
# Signing secret for the invoice-paid webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=""

# Stripe Price ids for the collection matrix (amounts live on the Price, not here):
#   新規入部費 前期(4–9月) ¥4,000 / 後期(10–3月) ¥2,000
#   継続(部費) 標準 ¥4,000 / 特別 ¥2,000（管理者のみ発行）
PRICE_SHINKI_ZENKI=""
PRICE_SHINKI_KOUKI=""
PRICE_KEIZOKU_STANDARD=""
PRICE_KEIZOKU_SPECIAL=""

# Days until an issued (send_invoice) invoice is due.
INVOICE_DAYS_UNTIL_DUE="7"

# --- Refund / Connect onboarding (OpenSpec: add-connect-onboarding) ---

# Signing secret for the Connect account.updated webhook endpoint (whsec_...).
# Connect events may use a separate endpoint from the invoice webhook; set the
# same value here if they share one. Leave empty for non-payout dev (the Stripe
# adapter is lazy, so non-payout requests work without it).
STRIPE_CONNECT_WEBHOOK_SECRET=""

# --- Payout execution / Jomon integration (OpenSpec: add-payout-execution,
#     corrected in fix-jomon-payout) ---

# Jomon API base URL and Bearer service token (Checkin -> Jomon, one-way). Only
# the live drivers (v1/v2) use these; leave empty for the stub (the default).
# NOTE: live Jomon currently has ONLY traQ OAuth/cookie auth and NO Bearer
# receiver, so the token is forward-looking — a real connection requires a
# Jomon-side addition before v1/v2 can be used end-to-end.
JOMON_API_BASE_URL=""
JOMON_API_TOKEN=""

# Jomon driver: "stub" (in-memory, dev/tests; the DEFAULT), "v1" or "v2" (live
# HTTP against the real traPtitech/Jomon API). The stub is functionally complete
# and key-free, so payout dev works without Jomon. The live drivers read approved
# requests from GET /api/applications (v1 ?current_state=accepted /
# v2 ?status=approved) and resolve the payee by traQ ID (v1 trap_id; v2 resolves
# the target UUID via GET /api/users). Write-back: v1 marks repaid via
# PUT /api/applications/{id}/states/repaid/{trapId}; v2 has NO write-back API yet
# (paid_at is read-only) so write-back is UNSUPPORTED and awaits a Jomon addition
# (the payout still settles as paid locally and the write-back is retried later).
JOMON_API_VERSION="stub"

# Default payout currency (smallest unit; jpy has no minor unit so whole yen).
# Jomon carries no currency, so live requests are always jpy regardless.
PAYOUT_CURRENCY="jpy"

# --- DEV ONLY tooling ---

# Enables GET /dev/login, which mints a session WITHOUT traQ OAuth / email
# verification for local UI testing (?as=admin|member|user|both). DANGEROUS:
# it is an auth bypass. Double-gated — the route also requires `import.meta.dev`,
# which is baked to `false` in the production build, so a built/production server
# returns 404 even if this is set. NEVER set this in production. Only takes effect
# under `pnpm dev`. Leave empty for the real traQ OAuth flow.
CHECKIN_DEV_LOGIN=""
